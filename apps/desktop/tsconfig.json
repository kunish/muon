      "@features/*": ["./src/features/*"],
      "@shared/*": ["./src/shared/*"],
      "@matrix/*": ["./src/matrix/*"],
      "@muon/enterprise-contracts": ["../../packages/enterprise-contracts/src/index.ts"],
