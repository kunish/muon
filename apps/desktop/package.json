{
  "name": "@muon/desktop",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Muon desktop Matrix chat client",
  "main": "out/main/main.cjs",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite",
    "build": "pnpm type-check && electron-vite build",
    "build:web": "vue-tsc --noEmit && vite build",
    "preview": "electron-vite preview",
    "package": "pnpm build && electron-builder --dir -c.mac.identity=null",
    "dist": "pnpm build && electron-builder",
    "check": "pnpm lint && pnpm test:unit && pnpm build",
    "lint": "eslint .",
    "type-check": "vue-tsc --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test:enterprise": "vitest run tests/unit/enterprise tests/components/AdminApp.test.ts tests/components/LoginPage.enterprise.test.ts",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test": "pnpm test:unit && pnpm test:e2e"
  },
  "build": {
    "appId": "com.muon.im",
    "productName": "Muon",
    "electronVersion": "41.3.0",
    "directories": {
      "output": "../../release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "../../build/icons/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "../../build/icons/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "../../build/icons/png-set",
      "target": [
        "AppImage"
      ]
    }
  },
  "dependencies": {
    "@floating-ui/vue": "catalog:",
    "@intlify/unplugin-vue-i18n": "catalog:",
    "@muon/enterprise-contracts": "workspace:*",
    "@muon/rich-text": "workspace:*",
    "@muon/ui": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/vue-form": "catalog:",
    "@tanstack/vue-query": "catalog:",
    "@tanstack/vue-store": "catalog:",
    "@tanstack/vue-table": "catalog:",
    "@tanstack/vue-virtual": "catalog:",
    "@tiptap/core": "catalog:",
    "@tiptap/extension-code-block-lowlight": "catalog:",
    "@tiptap/extension-collaboration": "catalog:",
    "@tiptap/extension-collaboration-cursor": "catalog:",
    "@tiptap/extension-image": "catalog:",
    "@tiptap/extension-link": "catalog:",
    "@tiptap/extension-mention": "catalog:",
    "@tiptap/extension-placeholder": "catalog:",
    "@tiptap/extension-table": "catalog:",
    "@tiptap/extension-underline": "catalog:",
    "@tiptap/pm": "catalog:",
    "@tiptap/starter-kit": "catalog:",
    "@tiptap/suggestion": "catalog:",
    "@tiptap/vue-3": "catalog:",
    "@vueuse/core": "catalog:",
    "blurhash": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "date-fns": "catalog:",
    "dexie": "catalog:",
    "dompurify": "catalog:",
    "effect": "catalog:",
    "electron-updater": "catalog:",
    "imapflow": "catalog:",
    "livekit-client": "catalog:",
    "lottie-web": "catalog:",
    "lowlight": "catalog:",
    "lucide-vue-next": "catalog:",
    "mailparser": "catalog:",
    "marked": "catalog:",
    "matrix-js-sdk": "catalog:",
    "mitt": "catalog:",
    "nanoid": "catalog:",
    "nodemailer": "catalog:",
    "pinia": "catalog:",
    "reka-ui": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "vue": "catalog:",
    "vue-i18n": "catalog:",
    "vue-router": "catalog:",
    "vue-sonner": "catalog:",
    "yjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/mailparser": "catalog:",
    "@types/node": "catalog:",
    "@types/nodemailer": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vue/test-utils": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "electron-vite": "catalog:",
    "jsdom": "catalog:",
    "msw": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
