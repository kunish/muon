{
  "name": "muon",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8",
  "description": "A modern, fast Matrix chat client built with Tauri and Vue 3",
  "author": "Muon Contributors",
  "license": "MIT",
  "homepage": "https://github.com/kunish/muon#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/kunish/muon.git"
  },
  "bugs": {
    "url": "https://github.com/kunish/muon/issues"
  },
  "keywords": [
    "matrix",
    "chat",
    "tauri",
    "vue",
    "desktop",
    "encrypted",
    "messenger"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint .",
    "type-check": "vue-tsc --noEmit",
    "services:up": "bash docker/start.sh",
    "services:seed": "npx --yes tsx scripts/seed-conduit.ts",
    "services:down": "docker compose -f docker/docker-compose.yml down",
    "services:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test": "pnpm test:unit && pnpm test:e2e"
  },
  "dependencies": {
    "@floating-ui/vue": "^1.1.11",
    "@intlify/unplugin-vue-i18n": "^11.1.2",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/vue-query": "^5.100.6",
    "@tanstack/vue-virtual": "^3.13.24",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-fs": "^2.5.0",
    "@tauri-apps/plugin-http": "^2.5.8",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@tiptap/extension-image": "^3.22.5",
    "@tiptap/extension-link": "^3.22.5",
    "@tiptap/extension-mention": "^3.22.5",
    "@tiptap/extension-placeholder": "^3.22.5",
    "@tiptap/extension-underline": "^3.22.5",
    "@tiptap/pm": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.5",
    "@tiptap/suggestion": "^3.22.5",
    "@tiptap/vue-3": "^3.22.5",
    "@vueuse/core": "^14.2.1",
    "@vueuse/gesture": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compressorjs": "^1.3.0",
    "date-fns": "^4.1.0",
    "dexie": "^4.4.2",
    "dompurify": "^3.4.1",
    "ky": "^2.0.2",
    "livekit-client": "^2.18.7",
    "lottie-web": "^5.13.0",
    "lucide-vue-next": "^1.0.0",
    "marked": "^18.0.2",
    "matrix-js-sdk": "^41.4.0",
    "mitt": "^3.0.1",
    "nanoid": "^5.1.9",
    "pinia": "^3.0.4",
    "plyr": "^3.8.4",
    "reka-ui": "^2.9.6",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "viewerjs": "^1.11.7",
    "vue": "^3.5.33",
    "vue-i18n": "^11.4.0",
    "vue-router": "^5.0.6",
    "vue-sonner": "^2.0.9",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.2.0",
    "@playwright/test": "^1.59.1",
    "@tauri-apps/cli": "^2.10.1",
    "@types/node": "^25.6.0",
    "@typescript-eslint/rule-tester": "^8.59.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/coverage-v8": "^4.1.5",
    "@vue/test-utils": "^2.4.9",
    "eslint": "^10.2.1",
    "eslint-plugin-format": "^2.0.1",
    "jsdom": "^29.1.0",
    "msw": "^2.14.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msw"
    ]
  }
}
